# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling
/graphify-out/
/test-results/
/playwright-report/
/supabase/.temp/
/supabase/.branches/
/playstore
# Android (Bubblewrap / Play Store): never commit signing keys or build output
playstore/*.keystore
playstore/*.jks
playstore/*.p12
playstore/*.aab
playstore/*.apk
playstore/.gradle/
playstore/build/
playstore/app/build/
*.keystore
*.jks
keystore.properties
# The Capacitor Android app (android/) is committed; its own android/.gitignore keeps out build output, google-services.json and signing files.
.aaaaaaa

# Firebase / Google credentials: never commit, wherever the file ends up. Render deploys from this repository, so anything committed
# is exposed; these go into the host's environment instead (FIREBASE_SERVICE_ACCOUNT, see docs/ANDROID_APP.md).
*-firebase-adminsdk-*.json
service-account*.json
google-services.json
GoogleService-Info.plist