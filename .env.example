# ─────────────────────────────────────────────────────────────────────────────
# UniSphere environment configuration
#   Copy to .env.local for development. Never commit real values.
#   Anything prefixed NEXT_PUBLIC_ is bundled into the browser — never put
#   secrets there. Everything else is server-only.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Canonical public origin. Used for metadataBase, sitemap, canonical URLs and
# links inside emails. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# ── Advertising (Google AdSense), all optional ───────────────────────────────
# Leave all three empty and the site shows no advertising and loads no ad code.
# Get the real values from your AdSense account (docs/ADSENSE.md); never invent them.
#   CLIENT_ID alone  -> adds the AdSense account meta tag and an ads.txt entry (what "connect site" needs)
#   + SLOT_ID + ENABLED=true -> ads render on the public pages that have an ad slot (after Google approves the site)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_ID=
NEXT_PUBLIC_ADS_ENABLED=
# Secret used to authenticate calls to /api/cron/* (worker + schedulers).
# Generate with: openssl rand -hex 32
CRON_SECRET=
# Development/test only (ignored in production): multiply all rate limits.
RATE_LIMIT_MULTIPLIER=1
# Secret for HMAC-ing one-time codes. REQUIRED in production. Generate with: openssl rand -hex 32
APP_SECRET=

# ── Supabase ─────────────────────────────────────────────────────────────────
# Local: run `npx supabase start` and copy values from `npx supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# Publishable key (sb_publishable_...). Safe for the browser; RLS protects data.
# Legacy alternative: NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — SERVER ONLY. Bypasses RLS; used only after an
# explicit server-side permission check. Legacy alternative: SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=

# ── Redis (cache, rate limiting, AI throttling) ──────────────────────────────
# Optional. Without it the app falls back to per-process in-memory limits.
# Local: redis://localhost:6379 (all keys are prefixed "unisphere:", safe to share)
# Upstash: rediss://default:<password>@<host>:6379
REDIS_URL=redis://localhost:6379

# ── Cloudflare R2 (file storage, S3-compatible API) ──────────────────────────
# Production: leave R2_ENDPOINT empty; it is derived from the account id.
# Leave empty for Cloudflare R2. (Only set for an S3-compatible emulator.)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Private bucket: verification documents, post/message attachments (signed URLs).
CLOUDFLARE_R2_BUCKET_NAME=unisphere-private
# Public bucket: avatars, covers, banners, community and project images.
CLOUDFLARE_R2_PUBLIC_BUCKET_NAME=unisphere-public
# Public base URL for the public bucket (r2.dev URL or custom domain).
# Local: http://localhost:9000/unisphere-public
CLOUDFLARE_R2_PUBLIC_URL=
# Same URL, exposed to the browser so components can build image URLs.
NEXT_PUBLIC_MEDIA_URL=
# If CLOUDFLARE_R2_PUBLIC_URL / NEXT_PUBLIC_MEDIA_URL are empty, avatars and banners are stored in the
# private bucket and served through /api/media (signed redirect). Set them for direct CDN delivery.
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_FORCE_PATH_STYLE=false
# R2 uses "auto". Some S3-compatible emulators (RustFS/MinIO) need a real region such as us-east-1.
CLOUDFLARE_R2_REGION=auto

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Without RESEND_API_KEY: in development, mail is delivered to the local Mailpit
# inbox (SMTP_DEV_*); in production, sends fail loudly and are recorded as failed.
RESEND_API_KEY=
# Must be on a domain you have verified in Resend (SPF/DKIM). See docs/EMAIL.md.
EMAIL_FROM="UniSphere <no-reply@example.com>"
EMAIL_REPLY_TO=
SMTP_DEV_HOST=127.0.0.1
SMTP_DEV_PORT=55325
# Development only: true routes app email to the local Mailpit inbox even if RESEND_API_KEY is set.
EMAIL_DEV_MAILPIT=false

# ── AI (LangChain + Groq) ────────────────────────────────────────────────────
# Master switch; admins can additionally disable AI at runtime via feature flags.
AI_ENABLED=true
GROQ_API_KEY=
# Pick models per task. Verify availability on /admin/ai (lists live models).
# Defaults verified against /openai/v1/models. Model catalogues change: /admin/ai lists what your key can use.
# FAST: short structured tasks (tags, titles, classification). SMART: reasoning (improvements, explanations).
GROQ_MODEL_FAST=qwen/qwen3.8-27b
GROQ_MODEL_SMART=openai/gpt-oss-120b
# Optional: policy-reasoning model used only for moderation suggestions.
GROQ_MODEL_SAFETY=
# Optional secondary provider: any OpenAI-compatible chat API (OpenRouter, Together, Ollama…).
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
# Usage guardrails
AI_DAILY_LIMIT_PER_USER=30
AI_REQUEST_TIMEOUT_MS=20000

# ── Embeddings (semantic search) — optional ──────────────────────────────────
# Groq does not provide embeddings. Semantic search is only active when a real
# embedding provider is configured; otherwise search uses full-text only.
#   EMBEDDING_PROVIDER = none | openai-compatible | gemini
EMBEDDING_PROVIDER=none
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Must match the vector(768) column. Changing it requires a migration.
EMBEDDING_DIMENSIONS=768

# ── Web Push (installed-app notifications; optional) ─────────────────────────
# Generate once with:  npx web-push generate-vapid-keys
# The public key is shipped to browsers; the private key must stay secret. Keep both for the life of the
# deployment: rotating them silently drops every member's push subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@your-domain.example

# ── Android app (Trusted Web Activity), optional: see docs/APP_STORES.md ─────
ANDROID_PACKAGE_NAME=
# SHA-256 fingerprint(s) of the app signing key, colon-separated hex; several separated by commas.
ANDROID_SHA256_CERT_FINGERPRINTS=
